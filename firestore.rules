rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* the signed-in member's own public profile document */
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /comments/{commentId} {
      allow read: if true;
      /* The name and avatar shown in the list are exactly what the browser sent, so both are
         required to be the values already stored in the writer's own profile document. There is
         deliberately no "profile document missing" exemption: while members could delete their own
         document, that exemption was an impersonation route (delete your row -> the identity check
         is skipped -> post as anybody, with their avatar). The site never deletes profile documents
         and a missing row is rebuilt automatically on the next page load, so requiring it costs
         nothing. get(key, '') keeps older documents that lack a field working. */
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 600
                    && request.resource.data.replyTo is string
                    && request.resource.data.replyTo.size() <= 40
                    && request.resource.data.replyName is string
                    && request.resource.data.replyName.size() <= 40
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 120000
                    && hasProfile()
                    && request.resource.data.name == myProfile().get('name', '')
                    && request.resource.data.photo == myProfile().get('photo', '');
      /* No update allowed on purpose: the site has no comment editing, and an owner-only
         update rule would let a member rewrite `uid` and hand their comment to someone
         else. Editing, if it ever ships, must keep uid and name immutable. */
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    /* one document per like: ID = <comment>_<uid> */
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.commentId is string
                    && likeId == request.resource.data.commentId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId));
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      /* No delete rule at all: the site has no delete-account feature, and a member being able to
         remove their own profile document would open the impersonation route the comment rule
         above closes (no document -> no stored identity to check). */
      /* Profile documents are public, so only the fields the site actually shows may be
         written. Without this a member could quietly park extra personal data in their own
         document and have every visitor read it. The application writes exactly these six. */
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['uid','name','photo','about','username','createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 120000
                    && request.resource.data.about is string
                    && request.resource.data.about.size() <= 500
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-z0-9._]{3,20}$');
    }

    /* one document per follow: ID = <follower>_<followed> */
    match /follows/{followId} {
      /* Privacy decision (2026-10-19): signed-in members only, not the whole internet. The
         profile page counts followers and following by querying this collection, and Firestore
         can only count documents the caller may read, so a member still sees the real numbers on
         any profile; an anonymous visitor sees "—" there. The documents hold nothing but a pair
         of opaque Firebase UIDs — no name, email or other personal field. */
      allow read: if request.auth != null;
      /* The canonical ID is what stops one account writing many follow documents for the
         same pair under random IDs, which would inflate everybody's public follower
         counts. The target must exist so fake uids cannot be stored either. */
      allow create: if request.auth != null
                    && request.resource.data.follower == request.auth.uid
                    && request.resource.data.following is string
                    && request.resource.data.following.size() <= 40
                    && request.resource.data.following != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.following
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.following));
      allow delete: if request.auth != null
                    && resource.data.follower == request.auth.uid;
    }

    /* friend request: ID = <sender>_<recipient>, status pending/accepted */
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from
                      || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() <= 40
                    && request.resource.data.to != request.auth.uid
                    && reqId == request.auth.uid + '_' + request.resource.data.to
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
                    && request.resource.data.status == 'pending';
      /* Only the recipient may flip pending -> accepted, and only once (the new status
         has to be 'accepted' while the old one is still 'pending'), so a sender cannot
         re-send or edit a request they already put out. */
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.to
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from
                        || request.auth.uid == resource.data.to);
    }

    /* friendship: ID = both uids sorted a-z; written by the recipient only after a
       request has really been accepted */
    match /friends/{fid} {
      /* Privacy decision (2026-10-19): a friendship is a personal association, so only the two
         people in it may read the document. Everything the site does with these documents keeps
         working — the Follow/Friend/Chat buttons read one pair document that always contains the
         viewer, and chat access is checked with get(), which ignores read rules. What changes: the
         Friends number on somebody else's profile reads "—", because a visitor cannot count
         documents they are not part of. To publish that number again it has to become a counter
         field on users/{uid} kept up to date by a server-side job — a browser-written counter is
         one any member could inflate. */
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.reqId is string
                    && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId))
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.status == 'accepted'
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.to == request.auth.uid
                    && request.resource.data.participants.hasOnly([
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.from,
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.to
                       ]);
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;
    }

    /* private chat: chatId = both uids sorted a-z, friends only.
       Membership is checked through the friends document (rules have no .split()) */
    match /chats/{chatId}/messages/{msgId} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/friends/$(chatId))
                  && request.auth.uid in get(/databases/$(database)/documents/friends/$(chatId)).data.participants;
      allow create: if request.auth != null
                  && exists(/databases/$(database)/documents/friends/$(chatId))
                  && request.auth.uid in get(/databases/$(database)/documents/friends/$(chatId)).data.participants
                  && request.resource.data.from == request.auth.uid
                  && request.resource.data.to in get(/databases/$(database)/documents/friends/$(chatId)).data.participants
                  && request.resource.data.to != request.auth.uid
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null
                    && resource.data.from == request.auth.uid;
    }
  }
}
