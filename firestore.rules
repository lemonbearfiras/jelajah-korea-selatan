rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 120000
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 600
                    && request.resource.data.replyTo is string
                    && request.resource.data.replyTo.size() <= 40
                    && request.resource.data.replyName is string
                    && request.resource.data.replyName.size() <= 40;
      /* No update allowed on purpose: the site has no comment editing, and an owner-only
         update rule would let a member rewrite `uid` and hand their comment to someone
         else. Editing, if it ever ships, must keep uid and name immutable. */
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    /* one document per like: ID = <comment>_<uid> */
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.commentId is string
                    && likeId == request.resource.data.commentId + '_' + request.auth.uid
                    && exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId));
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.photo is string
                    && request.resource.data.photo.size() <= 120000
                    && request.resource.data.about is string
                    && request.resource.data.about.size() <= 500
                    && request.resource.data.username is string
                    && request.resource.data.username.matches('^[a-z0-9._]{3,20}$');
    }

    /* one document per follow: ID = <follower>_<followed> */
    match /follows/{followId} {
      /* Public read is a deliberate choice, not an oversight: the profile page counts
         followers and following by querying this collection (js/pages/profile.js), and
         Firestore can only count documents the caller may read. The documents hold
         nothing but a pair of opaque Firebase UIDs — no name, email or any other
         personal field. To make the graph private instead, move the counts onto
         users/{uid} and change the line below to a participant check. */
      allow read: if true;
      /* The canonical ID is what stops one account writing many follow documents for the
         same pair under random IDs, which would inflate everybody's public follower
         counts. The target must exist so fake uids cannot be stored either. */
      allow create: if request.auth != null
                    && request.resource.data.follower == request.auth.uid
                    && request.resource.data.following is string
                    && request.resource.data.following.size() <= 40
                    && request.resource.data.following != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.following
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.following));
      allow delete: if request.auth != null
                    && resource.data.follower == request.auth.uid;
    }

    /* friend request: ID = <sender>_<recipient>, status pending/accepted */
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from
                      || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to.size() <= 40
                    && request.resource.data.to != request.auth.uid
                    && reqId == request.auth.uid + '_' + request.resource.data.to
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
                    && request.resource.data.status == 'pending';
      /* Only the recipient may flip pending -> accepted, and only once (the new status
         has to be 'accepted' while the old one is still 'pending'), so a sender cannot
         re-send or edit a request they already put out. */
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.to
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.from == resource.data.from
                    && request.resource.data.to == resource.data.to;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from
                        || request.auth.uid == resource.data.to);
    }

    /* friendship: ID = both uids sorted a-z; written by the recipient only after a
       request has really been accepted */
    match /friends/{fid} {
      /* Public read for the same reason as /follows — the profile page counts friends. */
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.reqId is string
                    && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId))
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.status == 'accepted'
                    && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.to == request.auth.uid
                    && request.resource.data.participants.hasOnly([
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.from,
                         get(/databases/$(database)/documents/friendRequests/$(request.resource.data.reqId)).data.to
                       ]);
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;
    }

    /* private chat: chatId = both uids sorted a-z, friends only.
       Membership is checked through the friends document (rules have no .split()) */
    match /chats/{chatId}/messages/{msgId} {
      allow read: if request.auth != null
                  && exists(/databases/$(database)/documents/friends/$(chatId))
                  && request.auth.uid in get(/databases/$(database)/documents/friends/$(chatId)).data.participants;
      allow create: if request.auth != null
                  && exists(/databases/$(database)/documents/friends/$(chatId))
                  && request.auth.uid in get(/databases/$(database)/documents/friends/$(chatId)).data.participants
                  && request.resource.data.from == request.auth.uid
                  && request.resource.data.to in get(/databases/$(database)/documents/friends/$(chatId)).data.participants
                  && request.resource.data.to != request.auth.uid
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null
                    && resource.data.from == request.auth.uid;
    }
  }
}
